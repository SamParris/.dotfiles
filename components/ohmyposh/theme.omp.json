{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╭─ ",
          "foreground": "#334155"
        },
        {
          "type": "os",
          "style": "plain",
          "template": "{{ if eq .OS \"windows\" }}󰍲  {{ else if eq .OS \"linux\" }}󰣇  {{ else }}󰣇  {{ end }}",
          "foreground_templates": [
            "{{ if eq .OS \"windows\" }}#0078D4{{ end }}",
            "{{ if eq .OS \"linux\" }}#C0CAF5{{ end }}"
          ]
        },
        {
          "type": "path",
          "style": "plain",
          "template": "  {{ .Path }} ",
          "foreground": "#22D3EE",
          "properties": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "mapped_locations": {
              "~": "~"
            }
          }
        },
        {
          "type": "git",
          "style": "plain",
          "template": "  {{ .Ref }}{{ if .Working.Untracked }} ?{{ .Working.Untracked }}{{ end }}{{ if .Working.Modified }} ~{{ .Working.Modified }}{{ end }}{{ if .Staging.Changed }} +{{ add .Staging.Added .Staging.Modified }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }} ",
          "foreground": "#FFBF00",
          "properties": {
            "fetch_status": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "filler": "·",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "template": " 󱦟 {{ .FormattedMs }}",
          "foreground": "#FACC15",
          "properties": {
            "threshold": 1000,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "template": " 󰥔 {{ .CurrentDate | date .Format }}",
          "foreground": "#22D3EE",
          "properties": {
            "time_format": "03:04:05 PM"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╰─",
          "foreground": "#334155"
        },
        {
          "type": "status",
          "style": "plain",
          "template": "❯",
          "foreground": "#5EFF6C",
          "foreground_templates": [
            "{{ if .Error }}#EF476F{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}